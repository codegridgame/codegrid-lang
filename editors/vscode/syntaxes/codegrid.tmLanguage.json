{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CodeGrid",
  "scopeName": "source.cg",
  "patterns": [
    { "include": "#comments" },
    { "include": "#directives" },
    { "include": "#cells" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.codegrid",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.codegrid",
          "match": "//.*$"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "match": "(?i)(@size)([ \\t]+)([0-9]*[1-9][0-9]*x[0-9]*[1-9][0-9]*)(?=$|[ \\t])",
          "captures": {
            "1": { "name": "keyword.directive.size.codegrid" },
            "2": { "name": "punctuation.whitespace.codegrid" },
            "3": { "name": "constant.numeric.size.codegrid" }
          }
        },
        {
          "name": "keyword.directive.size.codegrid",
          "match": "(?i)@size(?=$|\\s)"
        },
        {
          "match": "(?i)(@end)([ \\t]+)(main|C[0-9]|F[0-9](?:\\.M[0-9])?|M[0-9]|main\\.[FM][0-9](?:\\.M[0-9])?|C[0-9]\\.(?:F[0-9](?:\\.M[0-9])?|M[0-9])|F[0-9]\\.M[0-9])(?=$|[ \\t])",
          "captures": {
            "1": { "name": "keyword.directive.end.codegrid" },
            "2": { "name": "punctuation.whitespace.codegrid" },
            "3": { "name": "entity.name.definition.codegrid" }
          }
        },
        {
          "name": "keyword.directive.end.codegrid",
          "match": "(?i)@end(?=$|\\s)"
        },
        {
          "name": "keyword.directive.main.codegrid",
          "match": "(?i)@main(?=$|\\s)"
        },
        {
          "name": "keyword.directive.structure.codegrid",
          "match": "(?i)@(?:C[0-9](?:\\.(?:F[0-9](?:\\.M[0-9])?|M[0-9])?)?|F[0-9](?:\\.M[0-9])?|M[0-9]|main\\.[FM][0-9](?:\\.M[0-9])?)(?=$|\\s)"
        },
        {
          "name": "invalid.illegal.codegrid",
          "match": "(?i)@[a-z][a-z0-9.]*"
        },
        {
          "name": "invalid.illegal.codegrid",
          "match": "@(?=$|\\s)"
        }
      ]
    },
    "cells": {
      "patterns": [
        {
          "name": "constant.language.entry.codegrid",
          "match": "(~[\\^v<>])(?=$|\\s)",
          "captures": {
            "1": { "name": "constant.language.entry.codegrid" }
          }
        },
        {
          "name": "invalid.illegal.codegrid",
          "match": "~[^\\s]+"
        },
        {
          "name": "constant.language.empty-cell.codegrid",
          "match": "(_)(?=$|\\s)",
          "captures": {
            "1": { "name": "constant.language.empty-cell.codegrid" }
          }
        },
        {
          "match": "(#[<>v\\^])([*=]|x[2-5])?(?=$|\\s)",
          "captures": {
            "1": { "name": "keyword.operator.ifzero.codegrid" },
            "2": { "name": "storage.modifier.attachment.codegrid" }
          }
        },
        {
          "match": "(,[<>v\\^])([*=]|x[2-5])?(?=$|\\s)",
          "captures": {
            "1": { "name": "keyword.operator.read.codegrid" },
            "2": { "name": "storage.modifier.attachment.codegrid" }
          }
        },
        {
          "match": "(#[0-9])(?=$|\\s)",
          "captures": {
            "1": { "name": "keyword.control.custom-call.codegrid" }
          }
        },
        {
          "match": "(#\\])(?=$|\\s)",
          "captures": {
            "1": { "name": "keyword.control.custom-return.codegrid" }
          }
        },
        {
          "match": "(\\$&)([*=]|x[2-5])?(?=$|\\s)",
          "captures": {
            "1": { "name": "keyword.operator.nand.codegrid" },
            "2": { "name": "storage.modifier.attachment.codegrid" }
          }
        },
        {
          "match": "(\\$[()])([*=]|x[2-5])?(?=$|\\s)",
          "captures": {
            "1": { "name": "keyword.operator.memory.codegrid" },
            "2": { "name": "storage.modifier.attachment.codegrid" }
          }
        },
        {
          "match": "(\\$[+-])([*=]|x[2-5])?(?=$|\\s)",
          "captures": {
            "1": { "name": "keyword.operator.page.codegrid" },
            "2": { "name": "storage.modifier.attachment.codegrid" }
          }
        },
        {
          "match": "(\\$[<>])([*=]|x[2-5])?(?=$|\\s)",
          "captures": {
            "1": { "name": "keyword.operator.shift.codegrid" },
            "2": { "name": "storage.modifier.attachment.codegrid" }
          }
        },
        {
          "match": "(\\$[0-9])(?=$|\\s)",
          "captures": {
            "1": { "name": "keyword.control.folded-call.codegrid" }
          }
        },
        {
          "match": "(\\[[0-9])([*=])?(?=$|\\s)",
          "captures": {
            "1": { "name": "keyword.control.function-call.codegrid" },
            "2": { "name": "storage.modifier.attachment.codegrid" }
          }
        },
        {
          "match": "(\\])([*=])?(?=$|\\s)",
          "captures": {
            "1": { "name": "keyword.control.return.codegrid" },
            "2": { "name": "storage.modifier.attachment.codegrid" }
          }
        },
        {
          "match": "(\\$[<>&])([*=]|x[2-5])?(?=$|\\s)",
          "captures": {
            "1": { "name": "keyword.operator.codegrid" },
            "2": { "name": "storage.modifier.attachment.codegrid" }
          }
        },
        {
          "match": "([v\\^<>])([*=]|x[2-5])?(?=$|\\s)",
          "captures": {
            "1": { "name": "keyword.operator.direction.codegrid" },
            "2": { "name": "storage.modifier.attachment.codegrid" }
          }
        },
        {
          "match": "(\\?)([*=]|x[2-5])?(?=$|\\s)",
          "captures": {
            "1": { "name": "keyword.operator.random-direction.codegrid" },
            "2": { "name": "storage.modifier.attachment.codegrid" }
          }
        },
        {
          "match": "(!)([*=]|x[2-5])?(?=$|\\s)",
          "captures": {
            "1": { "name": "keyword.operator.clear.codegrid" },
            "2": { "name": "storage.modifier.attachment.codegrid" }
          }
        },
        {
          "match": "([+\\-])([*=]|x[2-5])?(?=$|\\s)",
          "captures": {
            "1": { "name": "keyword.operator.arithmetic.codegrid" },
            "2": { "name": "storage.modifier.attachment.codegrid" }
          }
        },
        {
          "match": "([{}])([*=]|x[2-5])?(?=$|\\s)",
          "captures": {
            "1": { "name": "keyword.operator.pointer.codegrid" },
            "2": { "name": "storage.modifier.attachment.codegrid" }
          }
        },
        {
          "match": "(\\.[0-9])(?=$|\\s)",
          "captures": {
            "1": { "name": "keyword.operator.output.codegrid" }
          }
        },
        {
          "match": "(\\.)([*=]|x[2-5])?(?=$|\\s)",
          "captures": {
            "1": { "name": "keyword.operator.output.codegrid" },
            "2": { "name": "storage.modifier.attachment.codegrid" }
          }
        },
        {
          "match": "([()])([*=]|x[2-5])?(?=$|\\s)",
          "captures": {
            "1": { "name": "keyword.operator.stack.codegrid" },
            "2": { "name": "storage.modifier.attachment.codegrid" }
          }
        },
        {
          "match": "([&%])([*=]|x[2-5])?(?=$|\\s)",
          "captures": {
            "1": { "name": "keyword.operator.encoding.codegrid" },
            "2": { "name": "storage.modifier.attachment.codegrid" }
          }
        },
        {
          "match": "(;)(?=$|\\s)",
          "captures": {
            "1": { "name": "keyword.control.halt.codegrid" }
          }
        },
        {
          "name": "invalid.illegal.codegrid",
          "match": "[^\\s]+"
        }
      ]
    }
  }
}
